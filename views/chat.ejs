<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>IT Assistant | BlockAidex</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <div class="mx-auto flex min-h-screen max-w-6xl flex-col px-4 sm:px-6">
      <header class="flex items-center justify-between border-b border-slate-800 py-5">
        <a href="/chat" class="flex items-center gap-3">
          <span class="grid h-10 w-10 place-items-center rounded-xl bg-cyan-400 font-black text-slate-950">B</span>
          <span class="text-lg font-semibold">BlockAidex <span class="font-normal text-slate-400">/ IT Assistant</span></span>
        </a>
        <div class="flex items-center gap-4">
          <span class="hidden text-sm text-slate-400 sm:inline"><%= user.name || user.email %></span>
          <% if (user.role === 'admin') { %>
            <a href="/admin" class="text-sm text-cyan-300 hover:text-cyan-200">Admin</a>
          <% } %>
          <form action="/logout" method="post"><button class="rounded-lg border border-slate-700 px-3 py-2 text-sm text-slate-300 hover:border-slate-500">Log out</button></form>
        </div>
      </header>

      <main class="flex flex-1 flex-col py-8">
        <div class="mb-6">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-cyan-300">Workplace help</p>
          <h1 class="mt-2 text-3xl font-semibold tracking-tight">How can we help?</h1>
          <p class="mt-2 text-slate-400">Ask about company IT procedures. Answers are grounded in the approved SOP library.</p>
        </div>

        <section id="conversation" aria-live="polite" class="flex-1 space-y-5 rounded-2xl border border-slate-800 bg-slate-900/70 p-4 sm:p-6">
          <% if (!chatSession || !chatSession.messages || chatSession.messages.length === 0) { %>
            <div id="empty-state" class="grid min-h-64 place-items-center text-center">
              <div>
                <div class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-cyan-400/10 text-2xl text-cyan-300">✦</div>
                <p class="mt-4 font-medium">Your IT assistant is ready</p>
                <p class="mt-1 text-sm text-slate-400">Try asking how to connect to the VPN or reset your password.</p>
              </div>
            </div>
          <% } else { %>
            <% chatSession.messages.forEach((message) => { %>
              <% if (message.sender !== 'system') { %>
                <article class="max-w-3xl <%= message.sender === 'user' ? 'ml-auto' : '' %>">
                  <div class="rounded-2xl px-4 py-3 <%= message.sender === 'user' ? 'bg-cyan-500 text-slate-950' : 'border border-slate-800 bg-slate-950 text-slate-100' %>">
                    <p class="whitespace-pre-wrap break-words text-sm leading-6"><%= message.text %></p>
                  </div>
                  <% if (message.sender !== 'user' && message.citations && message.citations.length) { %>
                    <div class="mt-2 flex flex-wrap gap-2">
                      <% message.citations.forEach((citation) => { %>
                        <span class="rounded-full border border-cyan-900 bg-cyan-950/60 px-2.5 py-1 text-xs text-cyan-200">Source · <%= citation %></span>
                      <% }) %>
                      <% if (typeof message.latencyMs === 'number') { %>
                        <span class="rounded-full border border-slate-700 px-2.5 py-1 text-xs text-slate-400"><%= message.latencyMs %> ms</span>
                      <% } %>
                    </div>
                  <% } else if (message.sender !== 'user' && typeof message.latencyMs === 'number') { %>
                    <span class="mt-2 inline-flex rounded-full border border-slate-700 px-2.5 py-1 text-xs text-slate-400"><%= message.latencyMs %> ms</span>
                  <% } %>
                </article>
              <% } %>
            <% }) %>
          <% } %>
        </section>

        <div id="error-message" role="alert" class="mt-4 hidden rounded-xl border border-rose-900 bg-rose-950/60 px-4 py-3 text-sm text-rose-200"></div>
        <form id="chat-form" class="mt-4 flex gap-3 rounded-2xl border border-slate-800 bg-slate-900 p-2">
          <label for="message" class="sr-only">Your question</label>
          <textarea id="message" name="message" rows="2" maxlength="10000" required placeholder="Describe your IT question..." class="max-h-40 min-h-12 flex-1 resize-y bg-transparent px-3 py-2 text-sm outline-none placeholder:text-slate-500"></textarea>
          <button id="send-button" type="submit" class="self-end rounded-xl bg-cyan-400 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300 disabled:cursor-not-allowed disabled:opacity-50">Send</button>
        </form>
        <p class="mt-3 text-center text-xs text-slate-500">Do not include passwords, MFA codes, or other sensitive information.</p>
      </main>
    </div>

    <script>
      const form = document.getElementById('chat-form');
      const conversation = document.getElementById('conversation');
      const messageInput = document.getElementById('message');
      const sendButton = document.getElementById('send-button');
      const errorMessage = document.getElementById('error-message');

      function addMessage(text, sender, citations, latencyMs) {
        const article = document.createElement('article');
        article.className = `max-w-3xl ${sender === 'user' ? 'ml-auto' : ''}`;
        const bubble = document.createElement('div');
        bubble.className = sender === 'user'
          ? 'rounded-2xl bg-cyan-500 px-4 py-3 text-slate-950'
          : 'rounded-2xl border border-slate-800 bg-slate-950 px-4 py-3 text-slate-100';
        const paragraph = document.createElement('p');
        paragraph.className = 'whitespace-pre-wrap break-words text-sm leading-6';
        paragraph.textContent = text;
        bubble.appendChild(paragraph);
        article.appendChild(bubble);

        if (sender !== 'user') {
          const tags = document.createElement('div');
          tags.className = 'mt-2 flex flex-wrap gap-2';
          (citations || []).forEach((citation) => {
            const badge = document.createElement('span');
            badge.className = 'rounded-full border border-cyan-900 bg-cyan-950/60 px-2.5 py-1 text-xs text-cyan-200';
            badge.textContent = `Source · ${citation}`;
            tags.appendChild(badge);
          });
          if (typeof latencyMs === 'number') {
            const badge = document.createElement('span');
            badge.className = 'rounded-full border border-slate-700 px-2.5 py-1 text-xs text-slate-400';
            badge.textContent = `${latencyMs} ms`;
            tags.appendChild(badge);
          }
          article.appendChild(tags);
        }

        conversation.appendChild(article);
        conversation.scrollTop = conversation.scrollHeight;
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const message = messageInput.value.trim();
        if (!message) return;

        errorMessage.textContent = '';
        errorMessage.classList.add('hidden');
        sendButton.disabled = true;
        addMessage(message, 'user', [], null);
        messageInput.value = '';

        try {
          const response = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ message }),
          });
          const result = await response.json();
          if (!response.ok) {
            throw new Error(result.error || 'Your message could not be processed.');
          }
          addMessage(result.reply, 'AI', result.citations, result.latencyMs);
        } catch (error) {
          errorMessage.textContent = error.message || 'A connection error occurred.';
          errorMessage.classList.remove('hidden');
        } finally {
          sendButton.disabled = false;
          messageInput.focus();
        }
      });
    </script>
  </body>
</html>