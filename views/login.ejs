<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign in | BlockAidex</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <main class="flex min-h-screen items-center justify-center px-5 py-12">
      <section class="w-full max-w-md">
        <a href="/login" class="mb-8 inline-flex items-center gap-3">
          <span class="grid h-11 w-11 place-items-center rounded-2xl bg-cyan-400 font-black text-slate-950">B</span>
          <span class="text-xl font-semibold tracking-tight">BlockAidex</span>
        </a>

        <div class="rounded-3xl border border-slate-800 bg-slate-900 p-6 shadow-2xl shadow-cyan-950/20 sm:p-8">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-300">IT support, made clear</p>
          <h1 class="mt-3 text-3xl font-semibold">Welcome to BlockAidex</h1>
          <p class="mt-2 text-sm text-slate-400">Sign in or create an employee account.</p>

          <% if (error) { %>
            <div role="alert" class="mt-6 rounded-xl border border-rose-900 bg-rose-950/60 px-4 py-3 text-sm text-rose-200"><%= error %></div>
          <% } %>

          <div class="mt-6 grid grid-cols-2 rounded-xl border border-slate-700 bg-slate-950 p-1" role="tablist" aria-label="Account options">
            <button id="login-tab" type="button" role="tab" aria-controls="login-panel" aria-selected="<%= activeTab === 'login' %>" class="rounded-lg px-3 py-2.5 text-sm font-medium transition <%= activeTab === 'login' ? 'bg-cyan-400 text-slate-950' : 'text-slate-400 hover:text-white' %>">Sign in</button>
            <button id="signup-tab" type="button" role="tab" aria-controls="signup-panel" aria-selected="<%= activeTab === 'signup' %>" class="rounded-lg px-3 py-2.5 text-sm font-medium transition <%= activeTab === 'signup' ? 'bg-cyan-400 text-slate-950' : 'text-slate-400 hover:text-white' %>">Create account</button>
          </div>

          <section id="login-panel" role="tabpanel" aria-labelledby="login-tab" class="<%= activeTab === 'login' ? '' : 'hidden' %>">
            <form action="/login" method="post" class="mt-6 space-y-5">
              <label class="block">
                <span class="mb-2 block text-sm font-medium text-slate-300">Work email</span>
                <input name="email" type="email" autocomplete="username" required class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20">
              </label>
              <label class="block">
                <span class="mb-2 block text-sm font-medium text-slate-300">Password</span>
                <span class="relative block">
                  <input id="login-password" name="password" type="password" autocomplete="current-password" required data-password-input class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 pr-12 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20">
                  <button type="button" data-password-toggle="login-password" aria-label="Show password" class="absolute inset-y-0 right-0 grid w-12 place-items-center text-slate-400 hover:text-cyan-300">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12s3.4-6 9.5-6 9.5 6 9.5 6-3.4 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                  </button>
                </span>
              </label>
              <button type="submit" class="w-full rounded-xl bg-cyan-400 px-4 py-3 font-semibold text-slate-950 transition hover:bg-cyan-300">Sign in</button>
            </form>

            <% if (demoCredentials) { %>
              <div class="mt-7 border-t border-slate-800 pt-6">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Development quick sign-in</p>
                <div class="mt-3 grid grid-cols-2 gap-3">
                  <button type="button" data-demo-email="<%= demoCredentials.admin.email %>" data-demo-password="<%= demoCredentials.admin.password %>" class="rounded-xl border border-slate-700 px-3 py-2.5 text-sm font-medium text-slate-200 transition hover:border-cyan-400 hover:text-cyan-200">Demo admin</button>
                  <button type="button" data-demo-email="<%= demoCredentials.employee.email %>" data-demo-password="<%= demoCredentials.employee.password %>" class="rounded-xl border border-slate-700 px-3 py-2.5 text-sm font-medium text-slate-200 transition hover:border-cyan-400 hover:text-cyan-200">Demo employee</button>
                </div>
              </div>
            <% } %>
          </section>

          <section id="signup-panel" role="tabpanel" aria-labelledby="signup-tab" class="<%= activeTab === 'signup' ? '' : 'hidden' %>">
            <form action="/signup" method="post" class="mt-6 space-y-5">
              <label class="block">
                <span class="mb-2 block text-sm font-medium text-slate-300">Full name</span>
                <input name="name" type="text" autocomplete="name" maxlength="100" required value="<%= signupName %>" class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20">
              </label>
              <label class="block">
                <span class="mb-2 block text-sm font-medium text-slate-300">Work email</span>
                <input name="email" type="email" autocomplete="email" maxlength="254" required value="<%= signupEmail %>" class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20">
              </label>
              <label class="block">
                <span class="mb-2 block text-sm font-medium text-slate-300">Password <span class="font-normal text-slate-500">(12 characters minimum)</span></span>
                <span class="relative block">
                  <input id="signup-password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="72" required data-password-input class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 pr-12 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20">
                  <button type="button" data-password-toggle="signup-password" aria-label="Show password" class="absolute inset-y-0 right-0 grid w-12 place-items-center text-slate-400 hover:text-cyan-300">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12s3.4-6 9.5-6 9.5 6 9.5 6-3.4 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                  </button>
                </span>
              </label>
              <button type="submit" class="w-full rounded-xl bg-cyan-400 px-4 py-3 font-semibold text-slate-950 transition hover:bg-cyan-300">Create employee account</button>
              <p class="text-center text-xs text-slate-500">New accounts receive employee access.</p>
            </form>
          </section>
        </div>
        <p class="mt-6 text-center text-xs text-slate-500">Protected organization access · Contact IT if you need help signing in.</p>
      </section>
    </main>
    <script>
      const loginTab = document.getElementById('login-tab');
      const signupTab = document.getElementById('signup-tab');
      const loginPanel = document.getElementById('login-panel');
      const signupPanel = document.getElementById('signup-panel');

      function selectTab(selected) {
        const showLogin = selected === 'login';
        loginPanel.classList.toggle('hidden', !showLogin);
        signupPanel.classList.toggle('hidden', showLogin);
        loginTab.setAttribute('aria-selected', String(showLogin));
        signupTab.setAttribute('aria-selected', String(!showLogin));
        loginTab.classList.toggle('bg-cyan-400', showLogin);
        loginTab.classList.toggle('text-slate-950', showLogin);
        loginTab.classList.toggle('text-slate-400', !showLogin);
        signupTab.classList.toggle('bg-cyan-400', !showLogin);
        signupTab.classList.toggle('text-slate-950', !showLogin);
        signupTab.classList.toggle('text-slate-400', showLogin);
      }

      loginTab.addEventListener('click', () => selectTab('login'));
      signupTab.addEventListener('click', () => selectTab('signup'));

      document.querySelectorAll('[data-password-toggle]').forEach((button) => {
        button.addEventListener('click', () => {
          const input = document.getElementById(button.dataset.passwordToggle);
          const visible = input.type === 'password';
          input.type = visible ? 'text' : 'password';
          button.setAttribute('aria-label', visible ? 'Hide password' : 'Show password');
        });
      });

      document.querySelectorAll('[data-demo-email]').forEach((button) => {
        button.addEventListener('click', () => {
          selectTab('login');
          document.querySelector('#login-panel [name="email"]').value = button.dataset.demoEmail;
          document.querySelector('#login-panel [name="password"]').value = button.dataset.demoPassword;
          document.querySelector('#login-panel [name="password"]').focus();
        });
      });
    </script>
  </body>
</html>
