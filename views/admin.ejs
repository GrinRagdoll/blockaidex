<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin dashboard | BlockAidex</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
      <header class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-800 pb-5">
        <a href="/admin" class="flex items-center gap-3">
          <span class="grid h-10 w-10 place-items-center rounded-xl bg-cyan-400 font-black text-slate-950">B</span>
          <span class="text-lg font-semibold">BlockAidex <span class="font-normal text-slate-400">/ Admin</span></span>
        </a>
        <div class="flex items-center gap-4">
          <span class="text-sm text-slate-400"><%= user.name || user.email %></span>
          <a href="/chat" class="text-sm text-cyan-300 hover:text-cyan-200">Open assistant</a>
          <form action="/logout" method="post"><button class="rounded-lg border border-slate-700 px-3 py-2 text-sm text-slate-300 hover:border-slate-500">Log out</button></form>
        </div>
      </header>

      <main class="py-8">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-cyan-300">Operations overview</p>
            <h1 class="mt-2 text-3xl font-semibold tracking-tight">IT support dashboard</h1>
            <p class="mt-2 text-slate-400">Live service metrics, SOP knowledge, and escalated conversations.</p>
          </div>
          <span class="rounded-full border border-emerald-900 bg-emerald-950/60 px-3 py-1.5 text-xs font-medium text-emerald-300">System online</span>
        </div>

        <% if (notice) { %>
          <div role="status" class="mt-6 rounded-xl border border-cyan-900 bg-cyan-950/50 px-4 py-3 text-sm text-cyan-200"><%= notice %></div>
        <% } %>

        <section aria-label="Key performance indicators" class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
          <article class="rounded-2xl border border-slate-800 bg-slate-900 p-5">
            <p class="text-sm text-slate-400">Total Queries</p>
            <p class="mt-3 text-3xl font-semibold"><%= kpis.totalQueries.toLocaleString() %></p>
            <p class="mt-2 text-xs text-slate-500">User messages recorded</p>
          </article>
          <article class="rounded-2xl border border-slate-800 bg-slate-900 p-5">
            <p class="text-sm text-slate-400">AI Deflection Rate</p>
            <p class="mt-3 text-3xl font-semibold"><%= kpis.aiDeflectionRate %><span class="ml-1 text-lg text-slate-400">%</span></p>
            <p class="mt-2 text-xs text-slate-500">Queries handled in AI-resolved sessions</p>
          </article>
          <article class="rounded-2xl border border-slate-800 bg-slate-900 p-5">
            <p class="text-sm text-slate-400">Avg Latency</p>
            <p class="mt-3 text-3xl font-semibold"><%= kpis.avgLatencyMs.toLocaleString() %><span class="ml-1 text-lg text-slate-400">ms</span></p>
            <p class="mt-2 text-xs text-slate-500">Assistant response time</p>
          </article>
          <article class="rounded-2xl border border-cyan-900/60 bg-cyan-950/20 p-5">
            <p class="text-sm text-cyan-200/70">User Satisfaction</p>
            <p class="mt-3 text-3xl font-semibold text-cyan-100"><%= kpis.userSatisfactionRate %><span class="ml-1 text-lg text-cyan-200/70">%</span></p>
            <p class="mt-2 text-xs text-cyan-100/50"><%= kpis.ratedResponses.toLocaleString() %> rated responses</p>
          </article>
          <article class="rounded-2xl border border-amber-900/60 bg-amber-950/20 p-5">
            <p class="text-sm text-amber-200/70">Escalated Tickets</p>
            <p class="mt-3 text-3xl font-semibold text-amber-100"><%= kpis.escalatedTickets.toLocaleString() %></p>
            <p class="mt-2 text-xs text-amber-100/50">Conversations waiting for an agent</p>
          </article>
        </section>

        <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1.5fr)_minmax(320px,0.8fr)]">
          <section class="rounded-2xl border border-slate-800 bg-slate-900 p-5 sm:p-6">
            <div class="flex items-center justify-between gap-4">
              <div>
                <h2 class="text-lg font-semibold">Escalated chat queue</h2>
                <p class="mt-1 text-sm text-slate-400">Review the conversation and reply to resolve it.</p>
              </div>
              <span class="rounded-full bg-amber-400/10 px-3 py-1 text-sm font-semibold text-amber-200"><%= escalatedChats.length %> open</span>
            </div>

            <% if (escalatedChats.length === 0) { %>
              <div class="mt-6 rounded-xl border border-dashed border-slate-700 px-5 py-10 text-center">
                <p class="font-medium text-slate-300">No escalated chats</p>
                <p class="mt-1 text-sm text-slate-500">New conversations needing a human will appear here.</p>
              </div>
            <% } else { %>
              <div class="mt-6 space-y-5">
                <% escalatedChats.forEach((chat) => { %>
                  <article class="rounded-xl border border-slate-800 bg-slate-950/70 p-4">
                    <div class="flex flex-wrap items-start justify-between gap-2">
                      <div>
                        <h3 class="font-medium"><%= chat.userId ? (chat.userId.name || chat.userId.email) : 'Unknown user' %></h3>
                        <p class="mt-1 text-xs text-slate-500"><%= chat.userId ? chat.userId.email : 'Account unavailable' %> · Session <%= chat._id %></p>
                      </div>
                      <time class="text-xs text-slate-500"><%= new Date(chat.updatedAt).toLocaleString() %></time>
                    </div>

                    <div class="mt-4 max-h-64 space-y-3 overflow-y-auto rounded-lg bg-slate-900 p-3">
                      <% chat.messages.forEach((message) => { %>
                        <div>
                          <p class="text-[11px] font-semibold uppercase tracking-wide text-cyan-300"><%= message.sender %></p>
                          <p class="mt-1 whitespace-pre-wrap break-words text-sm leading-5 text-slate-300"><%= message.text %></p>
                        </div>
                      <% }) %>
                    </div>

                    <form action="/admin/chats/<%= chat._id %>/reply" method="post" class="mt-4 space-y-3">
                      <label class="block">
                        <span class="sr-only">Reply to this chat</span>
                        <textarea name="reply" rows="3" maxlength="10000" required placeholder="Write a reply..." class="w-full rounded-xl border border-slate-700 bg-slate-900 px-3 py-2.5 text-sm outline-none focus:border-cyan-400"></textarea>
                      </label>
                      <div class="flex justify-end">
                        <button type="submit" class="rounded-xl bg-cyan-400 px-4 py-2.5 text-sm font-semibold text-slate-950 hover:bg-cyan-300">Send reply &amp; resolve</button>
                      </div>
                    </form>
                  </article>
                <% }) %>
              </div>
            <% } %>
          </section>

          <aside class="h-fit rounded-2xl border border-slate-800 bg-slate-900 p-5 sm:p-6">
            <div class="grid h-11 w-11 place-items-center rounded-xl bg-violet-400/10 text-xl text-violet-300">↥</div>
            <h2 class="mt-4 text-lg font-semibold">Update SOP library</h2>
            <p class="mt-1 text-sm leading-6 text-slate-400">Upload a TXT or Markdown procedure. The document is chunked and indexed for assistant answers.</p>
            <form action="/admin/sops" method="post" enctype="multipart/form-data" class="mt-5 space-y-4">
              <label class="block">
                <span class="mb-2 block text-sm font-medium text-slate-300">SOP file</span>
                <input type="file" name="sop" accept=".txt,.md,text/plain,text/markdown" required class="block w-full cursor-pointer rounded-xl border border-slate-700 bg-slate-950 text-sm text-slate-400 file:mr-4 file:border-0 file:bg-slate-800 file:px-4 file:py-3 file:text-sm file:font-medium file:text-slate-200 hover:file:bg-slate-700">
              </label>
              <p class="text-xs text-slate-500">Maximum file size: 2 MB. Only .txt and .md files are accepted.</p>
              <button type="submit" class="w-full rounded-xl border border-slate-700 px-4 py-3 text-sm font-semibold text-slate-100 transition hover:border-cyan-400 hover:text-cyan-200">Upload and index SOP</button>
            </form>
          </aside>
        </div>
      </main>
    </div>
  </body>
</html>